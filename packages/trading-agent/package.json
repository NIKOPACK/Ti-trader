{
	"name": "ti-trader",
	"version": "0.2.2",
	"description": "Ti — AI trading agent CLI with native buy/sell tools, trading commands, and paper or live crypto trading",
	"type": "module",
	"piConfig": {
		"configDir": ".ti-trader"
	},
	"bin": {
		"ti": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"pi": {
		"extensions": [
			"./dist/market-lab/index.js",
			"./dist/market-chart/index.js"
		]
	},
	"ti": {
		"extensions": [
			"./dist/market-lab/index.js",
			"./dist/market-chart/index.js"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm run clean && tsgo -p tsconfig.build.json && npm run build:web-search-extension && npm run build:market-lab-extension && npm run build:market-chart-extension && npm run build:market-research-extension && npm run build:zhihu-research-extension && npm run build:subagent-extension && npm run build:freqtrade-extension && shx chmod +x dist/cli.js",
		"build:web-search-extension": "tsgo -p ../../extensions/web-search/tsconfig.json && node ../../scripts/package-trading-extension.mjs web-search",
		"build:market-lab-extension": "tsgo -p ../../extensions/market-lab/tsconfig.json && node ../../scripts/package-trading-extension.mjs market-lab",
		"build:market-chart-extension": "tsgo -p ../../extensions/market-chart/tsconfig.json && node ../../scripts/package-trading-extension.mjs market-chart",
		"build:market-research-extension": "tsgo -p ../../extensions/market-research/tsconfig.json && node ../../scripts/package-trading-extension.mjs market-research",
		"build:zhihu-research-extension": "tsgo -p ../../extensions/zhihu-research/tsconfig.json && node ../../scripts/package-trading-extension.mjs zhihu-research",
		"build:subagent-extension": "tsgo -p ../../extensions/subagent/tsconfig.json && node ../../scripts/package-trading-extension.mjs subagent",
		"build:freqtrade-extension": "tsgo -p ../../extensions/freqtrade/tsconfig.json && node ../../scripts/package-trading-extension.mjs freqtrade",
		"test": "vitest --run src test --passWithNoTests",
		"smoke": "node scripts/smoke.mjs",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@nikopack/ti-trading-engine": "0.3.3",
		"@nikopack/ti-triggers": "0.1.0",
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3",
		"typebox": "1.3.7",
		"undici": "8.9.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"keywords": [
		"pi-package",
		"trading-agent",
		"ai",
		"llm",
		"cli",
		"crypto",
		"trading"
	],
	"author": "NIKOPACK",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NIKOPACK/Ti.git",
		"directory": "packages/trading-agent"
	},
	"homepage": "https://github.com/NIKOPACK/Ti#readme",
	"bugs": "https://github.com/NIKOPACK/Ti/issues",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	}
}
