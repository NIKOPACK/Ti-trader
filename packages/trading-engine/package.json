{
  "name": "@nikopack/ti-trading-engine",
  "version": "0.3.2",
  "description": "Framework-independent trading engine for Ti exchange integrations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "npm run clean && tsgo -p tsconfig.build.json",
    "test": "vitest --run src test --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nikopack/ti-trading-risk": "0.2.0",
    "ccxt": "4.5.58"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "engines": { "node": ">=22.19.0" },
  "license": "MIT"
}
